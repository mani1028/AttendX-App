require Pod::Executable.execute_command('node', ['-p',
  'require.resolve("react-native/scripts/react_native_pods.rb", {paths: [process.argv[1]]})', __dir__]).strip

platform :ios, '16.0'
prepare_react_native_project!

target 'AttendX' do
  config = use_native_modules!

  # RN Firebase messaging pulls Swift pods that require module maps when linked statically.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :hermes_enabled => true,
    :fabric_enabled => false,
    :new_arch_enabled => false
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['SWIFT_VERSION'] = '5.0'
        config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = '$(inherited)'

        if target.name == 'hermes-engine' && config.name == 'Release'
          config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
        end

        # Specifically fix UTType for NitroModules
        if target.name == 'NitroModules'
          config.build_settings['OTHER_SWIFT_FLAGS'] = '$(inherited) -D IOS_14_OR_LATER'
        end
      end
    end

    user_projects = installer.aggregate_targets.map(&:user_project).compact.uniq
    user_projects.each do |user_project|
      app_target = user_project.targets.find { |target| target.name == 'AttendX' }
      next unless app_target

      next if app_target.shell_script_build_phases.any? { |phase| phase.name == 'Generate Framework dSYMs' }

      build_phase = app_target.new_shell_script_build_phase('Generate Framework dSYMs')
      build_phase.shell_script = <<~SCRIPT
        set -e

        if [ "${CONFIGURATION}" != "Release" ]; then
          exit 0
        fi

        generate_dsym() {
          local framework_binary_path="${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}/$1"
          local dsym_output_path="${DWARF_DSYM_FOLDER_PATH}/$2.framework.dSYM"

          if [ -f "${framework_binary_path}" ]; then
            /usr/bin/dsymutil "${framework_binary_path}" -o "${dsym_output_path}" >/dev/null 2>&1 || true
          fi
        }

        generate_dsym "hermes.framework/hermes" "hermes"
        generate_dsym "GiphyUISDK.framework/GiphyUISDK" "GiphyUISDK"
      SCRIPT
    end
  end
end
