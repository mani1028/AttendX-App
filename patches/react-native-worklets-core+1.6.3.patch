+    std::unique_lock lock(_readWriteMutex);
+
+    auto depth = count > 0 ? arguments[0].asNumber() : -1;
+    std::vector<std::shared_ptr<JsiWrapper>> result =
+        flat_internal(depth, _array);
+    auto returnValue = jsi::Array(runtime, result.size());
