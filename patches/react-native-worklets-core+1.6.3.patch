+  static jsi::HostFunctionType createCallInContext(jsi::Runtime &runtime,
+                                                   const jsi::Value &maybeFunc,
+                                                   JsiWorkletContext *ctx);
+
+  /**
+   Calls a worklet function in a given context (or in the JS context if the ctx
