+        // Recursively call flat untill depth equals 0
+        if (depth <= -1 || depth > 0) {
+          auto childArray =
+              (static_cast<JsiArrayWrapper *>(it.get()))->getArray();
+          auto flattened = flat_internal(depth - 1, childArray);
+          for (auto child : flattened) {
+            result.push_back(child);
+          }
+        }
+      } else {
+        result.push_back(it);
+      }
+    }
+    return result;
+  }
