+          runtime, "createRunOnJS expects a function as its first parameter.");
+    }
+
+    if (!arguments[0].asObject(runtime).isFunction(runtime)) {
+      throw jsi::JSError(
+          runtime, "createRunOnJS expects a function as its first parameter.");
+    }
