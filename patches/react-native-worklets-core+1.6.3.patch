+    throw jsi::JSError(runtime,
+                       "Worklets.createRunInJsFn(..) has been deprecated in "
+                       "favor of Worklets.createRunOnJS(..) or "
+                       "Worklets.runOnJS(..) - please migrate to the new API!");
+  }
