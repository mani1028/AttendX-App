+    
+    std::vector<jsi::Value> args(3);
+    args[2] = thisValue.asObject(runtime);
+
+    for (size_t i = 0; i < _array.size(); i++) {
+      args[0] = _array.at(i)->unwrap(runtime);
+      args[1] = jsi::Value(static_cast<double>(i));
+      
